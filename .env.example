# ============================================================
# JARO AI — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- NVIDIA / LLM Provider Configuration ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional faster/lighter model for simple chat & classification:
# NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# Optional fallback OpenAI-compatible provider (e.g. Groq):
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Authentication & Session Signing ---
# Set a long random secret (>=32 chars) in production:
JARO_AUTH_SECRET=replace_with_32_plus_char_random_hex_secret

# --- Tavily Search API Key ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Broker Integrations (Read-Only Analytics) ---
# Upstox Analytics Token (Keep this server-side only; never prefix with NEXT_PUBLIC_)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_CLIENT_ID=your_upstox_client_id
UPSTOX_PIN=your_upstox_pin
UPSTOX_ACCESS_TOKEN=your_upstox_access_token
UPSTOX_ANALYTICS_TOKEN=your_upstox_analytics_token

# Angel One SmartAPI (Optional secondary market feed)
ANGEL_API_KEY=your_angel_api_key
ANGEL_CLIENT_ID=your_angel_client_id
ANGEL_PIN=your_angel_pin
ANGEL_TOTP_SECRET=your_angel_totp_secret
ANGEL_ROOT_URL=https://apiconnect.angelone.in

# m.Stock OpenAPI (Optional tertiary market feed)
MSTOCK_API_KEY=your_mstock_api_key
MSTOCK_CLIENT_ID=your_mstock_client_id
MSTOCK_PIN=your_mstock_pin
MSTOCK_TYPE_B_KEY=your_mstock_type_b_key
MSTOCK_BASE_URL=https://api.mstock.trade/openapi/typea

# --- Database ---
# SQLite (default for local dev; resolved relative to prisma/schema.prisma):
DATABASE_URL="file:./dev.db"
# Vercel / Remote PostgreSQL (Optional for production multi-tenant):
# DATABASE_URL="postgresql://user:password@host:5432/db"

# --- App URL ---
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
# For Vercel Production deployment, set:
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Compliance controls (safe defaults) ---
JARO_COMPLIANCE_MODE=education_and_general_research
JARO_PERSONALIZED_ADVICE_ENABLED=false
