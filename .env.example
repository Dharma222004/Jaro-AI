# ============================================================
# JARO AI — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Groq API Keys (Pool of up to 4 keys for rate-limit failover) ---
# Get keys at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key
GROQ_API_KEY_3=your_third_groq_api_key
GROQ_API_KEY_4=your_fourth_groq_api_key

# Groq model to use
GROQ_MODEL=openai/gpt-oss-120b

# --- Tavily API Keys (Pool of keys for automatic fallback & credit expansion) ---
# Supports TAVILY_API_KEY, TAVILY_API_KEY_2, TAVILY_API_KEY_3... up to N keys with automatic rotation and failover
# Get keys at: https://app.tavily.com
TAVILY_API_KEY=your_primary_tavily_key
TAVILY_API_KEY_2=your_second_tavily_key
TAVILY_API_KEY_3=your_third_tavily_key
TAVILY_API_KEY_4=your_fourth_tavily_key
TAVILY_API_KEY_5=your_fifth_tavily_key
TAVILY_API_KEY_6=your_sixth_tavily_key

# --- Database ---
# SQLite (default for local dev):
DATABASE_URL="file:./dev.db"
# For PostgreSQL/Supabase, replace with your connection string:
# DATABASE_URL="postgresql://user:password@host:5432/jaroai"

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
