# ============================================================
# JARO AI — Environment Configuration
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- NVIDIA API Key ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# --- Tavily Search API Key ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Upstox read-only market data ---
# Generate an Analytics Token in the Upstox Developer Apps Analytics tab.
# Keep this server-side only. Never prefix it with NEXT_PUBLIC_.
UPSTOX_ANALYTICS_TOKEN=YOUR_TOKEN

# --- Database ---
# SQLite (default for local dev):
DATABASE_URL="file:./prisma/dev.db"

# --- App ---
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Compliance controls (safe defaults) ---
JARO_COMPLIANCE_MODE=education_and_general_research
JARO_PERSONALIZED_ADVICE_ENABLED=false
