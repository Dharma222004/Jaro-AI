{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/research/start/route.ts": {
      "maxDuration": 300
    },
    "app/api/research/stream/route.ts": {
      "maxDuration": 300
    },
    "app/api/research/chat/route.ts": {
      "maxDuration": 120
    },
    "app/api/chat/route.ts": {
      "maxDuration": 300
    },
    "app/api/market/quote/route.ts": {
      "maxDuration": 30
    },
    "app/api/market/technical/route.ts": {
      "maxDuration": 60
    },
    "app/api/market/backtest/route.ts": {
      "maxDuration": 60
    },
    "app/api/market/upstox-status/route.ts": {
      "maxDuration": 30
    },
    "app/api/memory/route.ts": {
      "maxDuration": 30
    },
    "app/api/journal/route.ts": {
      "maxDuration": 60
    },
    "app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Jaro-Auth-Token" }
      ]
    }
  ]
}
